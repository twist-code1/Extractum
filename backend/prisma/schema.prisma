datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Projects {
  id         Int         @id @default(autoincrement())
  name       String      @unique
  paragraphs Paragraphs[]
}

model Paragraphs {
  id         Int     @id @default(autoincrement())
  title      String
  sourceLink String
  content    Json
  projectId  Int
  project    Projects @relation(fields: [projectId], references: [id], onDelete: Cascade)
}